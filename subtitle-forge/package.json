{
  "name": "subtitle-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental local-first CLI to extract, transcribe, translate and export video/audio subtitles.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "subtitle-forge": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
