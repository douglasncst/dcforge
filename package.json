{
  "name": "dcforge",
  "version": "0.1.0",
  "description": "Open-source TypeScript CLI for a Supabase-backed developer project registry.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/douglasncst/dcforge.git"
  },
  "bugs": {
    "url": "https://github.com/douglasncst/dcforge/issues"
  },
  "homepage": "https://github.com/douglasncst/dcforge#readme",
  "type": "module",
  "bin": {
    "dcforge": "./dist/index.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "keywords": [
    "dcforge",
    "cli",
    "developer-tools",
    "supabase",
    "typescript"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
